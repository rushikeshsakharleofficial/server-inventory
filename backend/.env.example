DATABASE_URL=postgresql://inventory:REPLACE_ME_POSTGRES_PASSWORD@localhost:5432/server_inventory
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_ME_RANDOM_SECRET_KEY
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY
# Required to create/rotate public API keys — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=REPLACE_ME_RANDOM_PEPPER
# HTTPS production: replace with the exact externally visible origin.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173
# Keep blank for a single same-origin nginx entry point.
VITE_API_URL=
# The default web port is loopback-only; expose this via a TLS reverse proxy.
WEB_BIND_IP=127.0.0.1
WEB_PORT=3001
